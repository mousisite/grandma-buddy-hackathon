# Secrets: the API key lives here. No .env file may ever be uploaded.
# .env.example is the only exception: it holds no real key.
.env
.env.*
!.env.example

# Grandma's data stays on this computer
data/
*.db
*.sqlite
*.sqlite3

# Voice recordings
*.wav

# Buddy's natural voice model (downloaded by scripts/get_voice.py)
models/

# Screenshots and files from browser checks
test-output/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Windows and editor files
Thumbs.db
desktop.ini
.DS_Store

# Design plugin work files (mockups and review screenshots)
.impeccable/mocks/
.impeccable/review/

# OBS takes for the demo video (big; the kit itself in video/ is kept)
video/raw/

# Reference videos downloaded for study only (other people's copyrighted work): never committed
video/reference/
# Remotion project packages
video/remotion/node_modules/
video/remotion/out/

# HyperFrames artifacts and the clips copied into the Remotion project
video/hyperframes-outro/.hyperframes/
video/remotion/public/media/
