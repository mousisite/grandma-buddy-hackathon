# Grandma Buddy settings
# 1. In VS Code, right-click this file, choose Copy, then Paste, and rename the copy to exactly: .env
# 2. In .env, replace paste-your-key-here with your real Meta Model API key.
# Never share .env or upload it anywhere. .gitignore already keeps it off GitHub.

MODEL_API_KEY=paste-your-key-here
CHAT_MODEL=muse-spark-1.3
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
LANGUAGE=English
DATABASE_PATH=data/grandma_buddy.db

# Optional: the Family plan's checkout on the family page, in Stripe's TEST
# mode only. A key must start with sk_test_ (a live key refuses to start, so
# nothing is ever really charged). Leave it empty for "Demo mode, no real
# charge", with no card fields at all.
STRIPE_SECRET_KEY=

# Optional, for checks only: where Meta's API is. Leave it out normally.
# scripts\check_failures.py sets it to a dead address to see every "Meta is
# down" message in the app.
# META_API_URL=https://api.meta.ai/v1

# Buddy's natural voice (optional). VOICE_THREADS=0 lets ONNX Runtime use every core; the
# public demo's host sets 2 for its 2 CPUs. VOICE_SENTENCES_PER_VISITOR_HOUR is each visitor's
# share of the voice in a public demo (PUBLIC_DEMO=1); the safety words are never capped.
# VOICE_THREADS=0
# VOICE_SENTENCES_PER_VISITOR_HOUR=300
